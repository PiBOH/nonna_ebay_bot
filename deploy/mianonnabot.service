[Unit]
Description=MiaNonnaBot - tracciamento prezzi eBay su Telegram
Documentation=https://github.com/PiBOH/nonna_ebay_bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mianonnabot
Group=mianonnabot
WorkingDirectory=/opt/mianonnabot

# I segreti (token, chiavi eBay) stanno in questo file, fuori dal repository.
# Permessi consigliati: 600, proprietario root.
EnvironmentFile=/etc/mianonnabot.env

ExecStart=/opt/mianonnabot/.venv/bin/python /opt/mianonnabot/main.py

# Se il bot cade (rete, riavvio, errore) systemd lo fa ripartire da solo.
Restart=always
RestartSec=15

# Piccole protezioni in più: niente privilegi root, filesystem quasi read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mianonnabot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mianonnabot

[Install]
WantedBy=multi-user.target
