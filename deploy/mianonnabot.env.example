# /etc/mianonnabot.env — letto da systemd con EnvironmentFile=
# Copialo, compilalo e proteggi il file:  chmod 600 /etc/mianonnabot.env
#
# Questo file NON va nel repository: contiene i segreti.

# --- Obbligatoria -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- eBay (opzionali: con queste il bot usa le API ufficiali) ---------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_IT

# --- Affiliazione eBay Partner Network (opzionale) --------------------------
EPN_CAMPAIGN_ID=

# --- Configurazione ---------------------------------------------------------
DATABASE_PATH=/opt/mianonnabot/mianonnabot.db
CHECK_INTERVAL_MINUTES=60
EBAY_SITE=www.ebay.it
MAX_TRACKED_PER_CHAT=50
REQUEST_DELAY_SECONDS=4
LOG_LEVEL=INFO
